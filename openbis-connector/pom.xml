<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>life.qbic</groupId>
    <artifactId>data-download-server</artifactId>
    <version>${revision}</version>
  </parent>

  <groupId>life.qbic.data-download</groupId>
  <artifactId>openbis-connector</artifactId>
  <packaging>jar</packaging>

  <repositories>
    <!-- The order of definitions matters. Explicitly defining central here to make sure it has the highest priority. -->
    <!-- Main Maven repository -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <!-- QBiC Maven Repository - hosts life.qbic:zzzz-openbis-api, which Maven Central does not
         carry. It is a static GitHub Pages file tree: no credentials, no snapshots, no
         maven-metadata.xml. This replaced the QBiC Nexus instance as a *dependency source*;
         Nexus is not reachable from GitHub Actions egress.

         Deliberately no <updatePolicy>always</updatePolicy> here. That setting is what turned
         an unreachable third-party host from a single failed lookup into a per-build stall.
         Do not put it back. -->
    <repository>
      <id>qbic-maven-repository</id>
      <name>QBiC Maven Repository</name>
      <url>https://qbicsoftware.github.io/maven-repository/releases</url>
      <releases>
        <checksumPolicy>fail</checksumPolicy>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>life.qbic</groupId>
      <artifactId>zzzz-openbis-api</artifactId>
      <version>20.10.7.3</version>
      <classifier>r1700646105</classifier>
    </dependency>
    <dependency>
      <groupId>life.qbic.data-download</groupId>
      <artifactId>measurement-provider</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>life.qbic.data-download</groupId>
      <artifactId>storage-provider</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>life.qbic.data_download.openbis.connector</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
